{
  "name": "my-child-game",
  "version": "1.0.0",
  "description": "儿童情景游戏 - 基于 Electron + React",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "build:electron": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "react",
    "children-game",
    "education",
    "personality-analysis",
    "mbti",
    "ai-analysis"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ing-la/zoosight-game.git"
  },
  "bugs": {
    "url": "https://github.com/Ing-la/zoosight-game/issues"
  },
  "homepage": "https://github.com/Ing-la/zoosight-game#readme",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@google/genai": "^1.0.0",
    "zustand": "^4.4.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.0",
    "dotenv": "^16.3.0"
  },
  "build": {
    "appId": "com.childgame.app",
    "productName": "儿童情景游戏",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/scenes/assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/scenes/assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/scenes/assets/icons/icon.png"
    }
  }
}

